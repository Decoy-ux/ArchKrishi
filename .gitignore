# =============================================================================
# Root .gitignore for FeildShift (Next.js Frontend + Python FastAPI Backend)
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets (Never commit credentials, API keys, or secrets)
# -----------------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Ensure sample/template env files are tracked
!.env.example
!.env.*.example

# -----------------------------------------------------------------------------
# Python / Backend
# -----------------------------------------------------------------------------
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / Packaging
build/
dist/
eggs/
*.egg-info/
*.egg
develop-eggs/
downloads/
parts/
var/
sdist/
wheels/

# Unit test / Coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# Static type checkers & Linters
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Local databases
*.sqlite3
*.db

# Jupyter / IPython
.ipynb_checkpoints

# -----------------------------------------------------------------------------
# Node.js & Next.js / Frontend
# -----------------------------------------------------------------------------
# Dependencies
node_modules/
jspm_packages/

# Next.js build output and static export
.next/
out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript
*.tsbuildinfo

# Test & Coverage
coverage/
.nyc_output/

# Vercel deployment
.vercel

# -----------------------------------------------------------------------------
# Operating System & Editor Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux / Vim / Emacs temporary files
*~
*.swp
*.swo
*.swn
.fuse_hidden*
.directory

# IDEs (VS Code / JetBrains / Sublime)
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# General Temporary / Log Files
# -----------------------------------------------------------------------------
*.log
tmp/
temp/

